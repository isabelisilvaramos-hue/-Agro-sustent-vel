/* style.css */

*{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body{
  font-family: Arial, sans-serif;
  background: #f4fff4;
  color: #333;
}

header{
  background: linear-gradient(to right, #2e7d32, #66bb6a);
  color: white;
  padding-bottom: 50px;
}

nav{
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
}

nav ul{
  display: flex;
  list-style: none;
  gap: 20px;
}

nav a{
  color: white;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
}

nav a:hover{
  color: #dcedc8;
}

.hero{
  text-align: center;
  margin-top: 60px;
  animation: aparecer 2s ease;
}

.hero h2{
  font-size: 42px;
  margin-bottom: 20px;
}

.hero p{
  width: 70%;
  margin: auto;
  font-size: 18px;
}

.hero button{
  margin-top: 25px;
  padding: 15px 30px;
  border: none;
  background: #1b5e20;
  color: white;
  font-size: 18px;
  border-radius: 10px;
  cursor: pointer;
  transition: 0.4s;
}

.hero button:hover{
  transform: scale(1.1);
  background: #0d3b12;
}

main{
  padding: 40px;
}

.card{
  background: white;
  padding: 30px;
  margin-bottom: 30px;
  border-radius: 15px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  transition: 0.4s;
}

.card:hover{
  transform: translateY(-5px);
}

.cards-container{
  display: flex;
  gap: 20px;
  margin-top: 20px;
  flex-wrap: wrap;
}

.mini-card{
  flex: 1;
  min-width: 200px;
  background: #e8f5e9;
  padding: 20px;
  border-radius: 10px;
  transition: 0.4s;
}

.mini-card:hover{
  background: #c8e6c9;
  transform: scale(1.05);
}

ul{
  margin-top: 20px;
  line-height: 2;
}

.contador{
  margin-top: 30px;
  text-align: center;
}

#numero{
  font-size: 50px;
  color: #2e7d32;
  font-weight: bold;
}

form{
  display: flex;
  flex-direction: column;
  gap: 15px;
}

input, textarea{
  padding: 12px;
  border: 2px solid #a5d6a7;
  border-radius: 8px;
}

form button{
  background: #2e7d32;
  color: white;
  border: none;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: 0.4s;
}

form button:hover{
  background: #1b5e20;
}

footer{
  background: #1b5e20;
  color: white;
  text-align: center;
  padding: 20px;
}

@keyframes aparecer{
  from{
    opacity: 0;
    transform: translateY(-20px);
  }

  to{
    opacity: 1;
    transform: translateY(0);
  }
}
